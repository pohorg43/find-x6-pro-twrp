on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on init
    setprop sys.usb.configfs 1
    setprop prepdecrypt.setpatch true
    setprop vendor.gatekeeper.disable_spu true
    setprop vendor.gatekeeper.is_security_level_spu 0

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    wait /dev/block/bootdevice/by-name/misc 5
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/clear-bcb.sh
    # Mount firmware, persist & symlink /vendor/firmware_mnt BEFORE TWRP starts & temporarily mounts /vendor
    mkdir /firmware 0771 system system
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    symlink /firmware /vendor/firmware_mnt
    mkdir /mnt/vendor 0771 system system
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/vendor/persist rw
    mkdir /data/vendor 0771 system system
    mkdir /data/vendor/tzstorage 0770 system system
    mkdir /data/vendor/qwes 0755 system system
    mkdir /data/vendor/time 0700 system system
    mkdir /data/vendor/qtee 0770 system system
    mkdir /data/vendor/tui 0700 system drmrpc
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on property:twrp.modules.loaded=true
    # Load ADSP firmware for PMIC GLINK & battery capacity
    wait /sys/kernel/boot_adsp/ssr 5
    write /sys/kernel/boot_adsp/ssr 1
    start override-spl
    wait /sys/class/power_supply/battery 5
    start health-hal-2-1

on property:vendor.twrp.spl_ready=1
    start vendor.qseecomd

on property:vendor.twrp.crypto_hal_ready=1
    start qseecom-service
    start vendor.keymint-qti
    enable gatekeeper-1-0
    start gatekeeper-1-0
    start vendor.ssgtzd

on property:vendor.twrp.keystore_ready=1
    enable keystore2
    start keystore2
