# Аппаратные и системные модули PGEM10 (топологический порядок из /vendor_dlkm/lib/modules/modules.dep):
# - ADSP / remoteproc / GLINK / QMI / PDR
# - PMIC GLINK + oplus_chg / oplus_chg_v2 / oplus_chg_symbol (батарея + haptics)
# - qseecom_proxy + smcinvoke_dlkm (Stage 2 TEE)
# - Тачскрин Synaptics TCM2 (+ Goodix fallback & NFC)
TWRP_TOUCH_MODULES="qcom_glink.ko qcom_glink_smem.ko qcom_smd.ko rproc_qcom_common.ko qmi_helpers.ko oplus_mm_kevent.ko oplus_mm_kevent_fb.ko qcom_ramdump.ko qcom_sysmon.ko oplus_mdmrst.ko qcom_q6v5.ko qcom_pil_info.ko qcom_q6v5_pas.ko pdr_interface.ko q6_pdr_dlkm.ko q6_notifier_dlkm.ko snd_event_dlkm.ko gpr_dlkm.ko spf_core_dlkm.ko adsp_loader_dlkm.ko pmic_glink.ko panel_event_notifier.ko kernel_fb.ko olc.ko oplus_bsp_fw_update.ko oplus_chg.ko ufcs_class.ko i2c-msm-geni.ko redriver.ko ucsi_glink.ko wcd_usbss_i2c.ko dwc3-msm.ko oplus_chg_v2.ko oplus_chg_symbol.ko qseecom_proxy.ko smcinvoke_dlkm.ko haptic_feedback.ko qcom-hv-haptics.ko oplus_bsp_tp_notify.ko oplus_bsp_tp_custom.ko oplus_bsp_tp_comon.ko oplus_bsp_tp_syna_comnon.ko oplus_bsp_tp_tcm_oncell.ko oplus_bsp_tp_tcm_S3910.ko synaptics_tcm2.ko oplus_bsp_tp_goodix_comnon.ko oplus_bsp_tp_gt9966.ko oplus_bsp_tp_gt9916.ko gh_mem_notifier.ko gh_irq_lend.ko goodix_ts.ko stm_st54se_gpio.ko nxp-nci.ko q6_dlkm.ko qcom_esoc.ko"

