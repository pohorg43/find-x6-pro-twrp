# Аппаратные и системные модули PGEM10 (Шаг A: строгий минимум из /vendor_dlkm/lib/modules/modules.dep):
# - ADSP / remoteproc / GLINK / QMI / PDR
# - PMIC GLINK + oplus_chg (датчик батареи, без oplus_chg_v2/dwc3/ufcs)
# - qseecom_proxy + smcinvoke_dlkm (проверка /dev/smcinvoke)
# - Тачскрин Synaptics TCM2 (+ базовый Stage 1 хвост)
TWRP_TOUCH_MODULES="qcom_glink.ko qcom_glink_smem.ko qcom_smd.ko rproc_qcom_common.ko qmi_helpers.ko oplus_mm_kevent.ko oplus_mm_kevent_fb.ko qcom_ramdump.ko qcom_sysmon.ko oplus_mdmrst.ko qcom_q6v5.ko qcom_pil_info.ko qcom_q6v5_pas.ko pdr_interface.ko q6_pdr_dlkm.ko q6_notifier_dlkm.ko snd_event_dlkm.ko gpr_dlkm.ko spf_core_dlkm.ko adsp_loader_dlkm.ko pmic_glink.ko panel_event_notifier.ko kernel_fb.ko olc.ko oplus_bsp_fw_update.ko oplus_chg.ko leds-qti-flash.ko qseecom_proxy.ko smcinvoke_dlkm.ko haptic_feedback.ko qcom-hv-haptics.ko oplus_bsp_tp_notify.ko oplus_bsp_tp_custom.ko oplus_bsp_tp_comon.ko oplus_bsp_tp_syna_comnon.ko oplus_bsp_tp_tcm_oncell.ko oplus_bsp_tp_tcm_S3910.ko synaptics_tcm2.ko oplus_bsp_tp_goodix_comnon.ko oplus_bsp_tp_gt9966.ko oplus_bsp_tp_gt9916.ko goodix_ts.ko stm_st54se_gpio.ko nxp-nci.ko q6_dlkm.ko qcom_esoc.ko"

# СТЕК ЭТАПА 2 (Шаг C — полный крипто-стек + работающий hwservicemanager, Шаг D/E — полировка и золотой v1.0):
# - Ранний предохранитель и оверрайд в /system/bin/: clear-bcb.sh (on fs, с обходом boot-fastboot/--fastboot), override-spl.sh (после unmount /vendor)
# - VINTF: android.hidl.manager@1.2 + boot@1.2 + health@2.1 + gatekeeper@1.0 + qseecom@1.0 + KeyMint V2 AIDL
# - TEE / KeyMint / Gatekeeper: /vendor/bin/qseecomd, ssgtzd, qseecom@1.0-service, keymint-service-qti, gatekeeper@1.0-service-qti
# - Фичи Шага E: fastbootd + touch, leds-qti-flash.ko фонарик, менеджер модулей Magisk/KSU/APatch, sqlite3 CLI
# - ro.boot.prjname: 21131
