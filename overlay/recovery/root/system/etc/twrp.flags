# Boot / recovery A/B partitions (slotselect, flashable & backupable via Install Image / Backup)
/recovery       emmc    /dev/block/bootdevice/by-name/recovery          flags=display="Recovery";slotselect;flashimg=1;backup=1
/boot           emmc    /dev/block/bootdevice/by-name/boot              flags=display="Boot";slotselect;flashimg=1;backup=1
/init_boot      emmc    /dev/block/bootdevice/by-name/init_boot         flags=display="Init Boot";slotselect;flashimg=1;backup=1
/vendor_boot    emmc    /dev/block/bootdevice/by-name/vendor_boot       flags=display="Vendor Boot";slotselect;flashimg=1;backup=1
/dtbo           emmc    /dev/block/bootdevice/by-name/dtbo              flags=display="DTBO";slotselect;flashimg=1;backup=1

# EFS / modem NV partitions (strictly backup-only: NO flashimg, NO wipeingui)
/efs1           emmc    /dev/block/bootdevice/by-name/modemst1          flags=display="EFS";backup=1
/efs2           emmc    /dev/block/bootdevice/by-name/modemst2          flags=backup=1;subpartitionof=/efs1
/efsg           emmc    /dev/block/bootdevice/by-name/fsg               flags=backup=1;subpartitionof=/efs1
/efsc           emmc    /dev/block/bootdevice/by-name/fsc               flags=backup=1;subpartitionof=/efs1

# Removable USB-OTG storage (system_ext, vendor_dlkm, metadata, misc are handled by recovery.fstab)
/usbstorage     vfat    /dev/block/sdg1                                 /dev/block/sdg      flags=fsflags=utf8;display="USB-OTG";storage;wipeingui;removable
