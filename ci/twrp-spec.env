# Ground Truth устройства: OPPO Find X6 Pro (PGEM10 / SM8550 / kalama)
DEVICE_CODENAME="PGEM10"
PLATFORM="sm8550"
BOARD_NAME="kalama"
COLOROS_VERSION="16.0.1.300"
ANDROID_VERSION="16"
STOCK_UNAME_R="5.15.167-android13-8-o-01155-ga71f0d7db4db"
ACTIVE_SLOT="_a"
RECOVERY_PART_A="/dev/block/by-name/recovery_a"
RECOVERY_PART_B="/dev/block/by-name/recovery_b"
BOARD_RECOVERYIMAGE_PARTITION_SIZE="104857600"

# Header параметры (совпадение со стоковым recovery_b для ABL кнопок)
TARGET_BOOT_HEADER_VERSION="4"
TARGET_OS_VERSION="13.0.0"
TARGET_OS_PATCH_LEVEL="2025-11"

# Референсные репозитории
REF_TREE_SM8550="https://github.com/kexi1412/twrp_device_oplus_sm8550"
REF_TREE_SM8550_BRANCH="master"
REF_TREE_SM8550_SHA="4d8bc349fe540212329d03279caea06aabaef1bf"

REF_TREE_SM87XX="https://github.com/kmiit/twrp_device_oplus_sm87xx"
REF_TREE_SM87XX_BRANCH="twrp-16.0"
REF_TREE_SM87XX_SHA="74d075623b35f685fcde82efb5a43548697d1a6e"

REF_MANIFEST_A16="https://github.com/TWRP-Test/platform_manifest_twrp_aosp"
REF_MANIFEST_BRANCH="twrp-16.0"
REF_MANIFEST_SHA="814b553116ceedde197f70389cff9661d81d8337"

# GitHub Repo Config
GITHUB_REPO_NAME="pohorg43/find-x6-pro-twrp"
GITHUB_REPO_VISIBILITY="private"

# Аппаратные модули тачскрина Synaptics TCM2 (порядок загрузки из modules.dep)
TWRP_TOUCH_MODULES="adsp_loader_dlkm.ko rproc_qcom_common.ko q6_dlkm.ko qcom_q6v5.ko qcom_q6v5_pas.ko qcom_esoc.ko qcom_sysmon.ko qcom-hv-haptics.ko haptic_feedback.ko oplus_chg.ko oplus_chg_v2.ko panel_event_notifier.ko olc.ko oplus_bsp_tp_notify.ko oplus_bsp_tp_custom.ko oplus_bsp_fw_update.ko oplus_bsp_tp_comon.ko oplus_bsp_tp_syna_comnon.ko oplus_bsp_tp_tcm_oncell.ko oplus_bsp_tp_tcm_S3910.ko synaptics_tcm2.ko oplus_bsp_tp_goodix_comnon.ko oplus_bsp_tp_gt9966.ko oplus_bsp_tp_gt9916.ko goodix_ts.ko stm_st54se_gpio.ko nxp-nci.ko"

# ЗАМЕТКА НА ЭТАП 2 (расшифровка /data):
# На PGEM10 (ColorOS 16.0.1.300) активна гибридная схема:
# - AIDL KeyMint: /vendor/bin/hw/android.hardware.security.keymint-service-qti
# - HIDL Gatekeeper: /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti (не AIDL Gatekeeper, как в kmiit/sm87xx!)
# - Boot HAL: /vendor/bin/hw/android.hardware.boot@1.2-service
# - ro.boot.prjname: 21131
